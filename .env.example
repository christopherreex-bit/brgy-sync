# BrgySync — Environment Variables Template
# Copy this to .env and fill in your real values:
#   copy .env.example .env    (Windows)
#   cp .env.example .env      (macOS/Linux)
# Full guide: plan/ENV_SETUP.md

# ─── Firebase ──────────────────────────────────────────────────────
# Used by: cron scripts, seed-data.js, seed-admin.js
# Get it from: Firebase Console → Project Settings → Service Accounts → Generate new private key
# IMPORTANT: Stringify the entire JSON to a single line (no newlines)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"YOUR_PROJECT_ID"}

# ─── EasySendSMS (Primary SMS Provider) ────────────────────────────
# Used by: Flutter web build (--dart-define)
# Sign up at: https://my.easysendsms.app/register (15 free credits)
# Get API key: Dashboard → API Settings → REST API
EASYSENDSMS_API_KEY=your_api_key_here

# ─── Twilio (Fallback SMS Provider) ────────────────────────────────
# Used by: Flutter web build (--dart-define), cron SMS alerts
# Get it from: https://console.twilio.com → Dashboard
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM=+1XXXXXXXXXX

# ─── Cloudflare ────────────────────────────────────────────────────
# Used by: GitHub Actions deploy workflow (stored as GitHub Secrets)
# Get Account ID: Cloudflare Dashboard → Workers & Pages → Overview → Account ID
# Get API Token: Cloudflare Dashboard → My Profile → API Tokens → Create Token
#   Token permissions: Cloudflare Pages → Edit
CF_API_TOKEN=your_cloudflare_api_token_here
CF_ACCOUNT_ID=your_cloudflare_account_id_here

# ─── Admin Seed Account ────────────────────────────────────────────
# Used by: scripts/seed-admin.js
# These are YOUR chosen credentials for the initial Barangay Captain account
ADMIN_EMAIL=captain@barangay.test
ADMIN_PASSWORD=choose_a_strong_password
ADMIN_NAME=Barangay Captain
ADMIN_MOBILE=09XXXXXXXXX
