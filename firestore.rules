rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ────────────────────────────────────────
    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isResident() { return getRole() == 'resident'; }
    function isStaff()   { return getRole() in ['staff', 'officer', 'captain']; }
    function isOfficer() { return getRole() in ['officer', 'captain']; }
    function isCaptain() { return getRole() == 'captain'; }
    function currentUserMobile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.mobile;
    }
    function canCreateCaseForResident(caseData) {
      return caseData.residentId == request.auth.uid
             || (isStaff()
                 && caseData.submissionChannel == 'walk_in'
                 && caseData.encodedById == request.auth.uid
                 && exists(/databases/$(database)/documents/users/$(caseData.residentId))
                 && get(/databases/$(database)/documents/users/$(caseData.residentId)).data.role == 'resident');
    }

    // ─── Users ───────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth.uid == userId || isStaff();
      allow write: if request.auth.uid == userId || isCaptain();
    }

    // Mobile numbers claimed by newly created accounts. Document IDs are the
    // normalized 09XXXXXXXXX number, making concurrent duplicate claims fail.
    match /mobileIdentifiers/{mobile} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
                    && mobile.matches('^09[0-9]{9}$')
                    && request.resource.data.uid is string
                    && (request.resource.data.uid == request.auth.uid || isCaptain());
      allow update: if false;
      allow delete: if request.auth != null
                    && (resource.data.uid == request.auth.uid || isCaptain());
    }

    // ─── Citizen Registry ────────────────────────────────────────
    // The registry is authoritative and independent of login accounts.
    // Residents can only read a record whose unique mobile matches their
    // account; registry creation and edits remain barangay-controlled.
    match /citizenRegistry/{registryId} {
      allow read: if isStaff()
                  || (request.auth != null
                      && resource.data.mobile == currentUserMobile());
      allow create: if isStaff()
                    || (request.auth != null
                        && registryId == request.resource.data.mobile
                        && request.resource.data.createdByAccountId == request.auth.uid
                        && request.resource.data.source == 'account_registration'
                        && request.resource.data.verificationStatus == 'pending_verification'
                        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
                        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'resident'
                        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.mobile
                            == request.resource.data.mobile);
      allow update: if isStaff();
      allow delete: if isCaptain();

      match /verifiedDocuments/{documentId} {
        allow read: if isStaff()
                    || (request.auth != null
                        && get(/databases/$(database)/documents/citizenRegistry/$(registryId)).data.mobile
                            == currentUserMobile());
        allow create, update: if isStaff();
        allow delete: if isCaptain();
      }

    }

    match /registryCorrections/{correctionId} {
      allow read: if isStaff()
                  || (request.auth != null
                      && resource.data.residentId == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.residentId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.requestedChanges is map
                    && exists(/databases/$(database)/documents/citizenRegistry/$(request.resource.data.registryId))
                    && get(/databases/$(database)/documents/citizenRegistry/$(request.resource.data.registryId)).data.mobile
                        == currentUserMobile();
      allow update: if isOfficer();
      allow delete: if false;
    }

    // A case creates one immutable observation that staff can compare with the
    // verified registry without silently replacing authoritative information.
    match /registryObservations/{caseId} {
      allow read: if isStaff()
                  || (request.auth != null
                      && resource.data.residentId == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.caseId == caseId
                    && existsAfter(/databases/$(database)/documents/cases/$(caseId))
                    && canCreateCaseForResident(
                         getAfter(/databases/$(database)/documents/cases/$(caseId)).data
                       );
      allow update: if isStaff();
      allow delete: if isCaptain();
    }

    // ─── Cases ───────────────────────────────────────────────────
    match /cases/{caseId} {
      allow read: if request.auth.uid == resource.data.residentId || isStaff();
      // Residents reserve the globally next sequence number and create their
      // case together in one atomic transaction.
      allow create: if request.auth != null
                    && canCreateCaseForResident(request.resource.data)
                    && request.resource.data.sequenceYear is int
                    && request.resource.data.sequenceNumber is int
                    && getAfter(/databases/$(database)/documents/caseCounters/$(request.resource.data.sequenceYear)).data.lastCaseId == caseId
                    && getAfter(/databases/$(database)/documents/caseCounters/$(request.resource.data.sequenceYear)).data.lastNumber == request.resource.data.sequenceNumber;
      // Staff and officers may update cases, but only the captain may perform
      // the final transition into For Claiming.
      allow update: if isStaff()
                    && (request.resource.data.status != 'for_claiming'
                        || isCaptain())
                    || (request.auth != null
                        && resource.data.residentId == request.auth.uid
                        && resource.data.status == 'needs_correction'
                        && request.resource.data.status
                            == resource.data.correctionRequest.returnStatus
                        && request.resource.data.status
                            in ['pending_review', 'processing']
                        && request.resource.data.correctionRequest.status == 'submitted'
                        && request.resource.data.correctionRequest.submittedBy == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly([
                              'requestDetails',
                              'documents',
                              'status',
                              'lastUpdated',
                              'statusUpdatedAt',
                              'correctionRequest'
                            ]));
      allow delete: if request.auth != null
                    && (resource.data.residentId == request.auth.uid || isCaptain())
                    && existsAfter(/databases/$(database)/documents/auditEvents/$(caseId))
                    && getAfter(/databases/$(database)/documents/auditEvents/$(caseId)).data.eventType == 'case_deleted'
                    && getAfter(/databases/$(database)/documents/auditEvents/$(caseId)).data.actorId == request.auth.uid;

    }

    // ─── Global Case Number Counters ─────────────────────────────
    // One counter per calendar year, shared by every resident.
    match /caseCounters/{year} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.lastNumber == 1
                    && request.resource.data.lastCaseId is string
                    && existsAfter(/databases/$(database)/documents/cases/$(request.resource.data.lastCaseId))
                    && canCreateCaseForResident(getAfter(/databases/$(database)/documents/cases/$(request.resource.data.lastCaseId)).data)
                    && getAfter(/databases/$(database)/documents/cases/$(request.resource.data.lastCaseId)).data.sequenceNumber == 1;
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['lastNumber', 'lastCaseId', 'lastUpdated'])
                    && request.resource.data.lastNumber == resource.data.lastNumber + 1
                    && request.resource.data.lastCaseId is string
                    && existsAfter(/databases/$(database)/documents/cases/$(request.resource.data.lastCaseId))
                    && canCreateCaseForResident(getAfter(/databases/$(database)/documents/cases/$(request.resource.data.lastCaseId)).data)
                    && getAfter(/databases/$(database)/documents/cases/$(request.resource.data.lastCaseId)).data.sequenceNumber == request.resource.data.lastNumber;
      allow delete: if false;
    }

    // ─── Action Log — collection group access ───────────────────
    // Top-level match required for collectionGroup('actionLog') queries
    match /{path=**}/actionLog/{logId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /cases/{caseId}/actionLog/{logId} {
      allow read, delete: if request.auth != null
                          && (get(/databases/$(database)/documents/cases/$(caseId)).data.residentId == request.auth.uid
                              || isCaptain());
      allow create: if request.auth != null
                    && request.resource.data.residentCorrection == true
                    && request.resource.data.staffId == request.auth.uid
                    && request.resource.data.previousStatus == 'needs_correction'
                    && request.resource.data.newStatus
                        == getAfter(/databases/$(database)/documents/cases/$(caseId)).data.status
                    && getAfter(/databases/$(database)/documents/cases/$(caseId)).data.residentId == request.auth.uid
                    && getAfter(/databases/$(database)/documents/cases/$(caseId)).data.status
                        in ['pending_review', 'processing'];
    }

    // Immutable record required whenever a case is permanently deleted.
    match /auditEvents/{caseId} {
      allow read: if isStaff();
      allow create: if request.auth != null
                    && request.resource.data.eventType == 'case_deleted'
                    && request.resource.data.caseId == caseId
                    && request.resource.data.actorId == request.auth.uid
                    && request.resource.data.deletionReason is string
                    && request.resource.data.deletionReason.size() > 0
                    && request.resource.data.referenceNumber
                        == get(/databases/$(database)/documents/cases/$(caseId)).data.referenceNumber
                    && (get(/databases/$(database)/documents/cases/$(caseId)).data.residentId == request.auth.uid
                        || isCaptain())
                    && !existsAfter(/databases/$(database)/documents/cases/$(caseId));
      allow update, delete: if false;
    }

    // ─── SLA Config ──────────────────────────────────────────────
    match /slaConfig/{doc} {
      // Residents also need these values to calculate the deadline attached
      // to a newly submitted case.
      allow read: if request.auth != null;
      allow write: if isCaptain();
    }

    // ─── Budget Programs ─────────────────────────────────────────
    match /budgetPrograms/{doc} {
      allow read: if request.auth != null;
      allow create, delete: if isCaptain();
      allow update: if isCaptain()
                    || (isStaff()
                        && request.resource.data.diff(resource.data)
                            .affectedKeys()
                            .hasOnly(['utilized', 'reserved', 'remaining', 'status', 'lastUpdated'])
                        && request.resource.data.utilized >= resource.data.utilized
                        && request.resource.data.remaining
                            == request.resource.data.allocated
                               - request.resource.data.utilized
                               - request.resource.data.reserved)
                    || (request.auth != null
                        && request.resource.data.diff(resource.data)
                            .affectedKeys()
                            .hasOnly([
                              'utilized',
                              'reserved',
                              'remaining',
                              'status',
                              'lastReversalCaseId',
                              'lastUpdated'
                            ])
                        && request.resource.data.lastReversalCaseId is string
                        && request.resource.data.utilized <= resource.data.utilized
                        && request.resource.data.remaining
                            == request.resource.data.allocated
                               - request.resource.data.utilized
                               - request.resource.data.reserved
                        && existsAfter(
                             /databases/$(database)/documents/auditEvents/$(request.resource.data.lastReversalCaseId)
                           )
                        && getAfter(
                             /databases/$(database)/documents/auditEvents/$(request.resource.data.lastReversalCaseId)
                           ).data.actorId == request.auth.uid
                        && getAfter(
                             /databases/$(database)/documents/auditEvents/$(request.resource.data.lastReversalCaseId)
                           ).data.budgetProgramId == doc
                        && existsAfter(
                             /databases/$(database)/documents/budgetReversals/$(request.resource.data.lastReversalCaseId)
                           )
                        && getAfter(
                             /databases/$(database)/documents/budgetReversals/$(request.resource.data.lastReversalCaseId)
                           ).data.programId == doc
                        && (getAfter(
                              /databases/$(database)/documents/budgetReversals/$(request.resource.data.lastReversalCaseId)
                            ).data.amount
                             == resource.data.utilized
                                - request.resource.data.utilized
                            || getAfter(
                                 /databases/$(database)/documents/budgetReversals/$(request.resource.data.lastReversalCaseId)
                               ).data.amount
                                == resource.data.reserved
                                   - request.resource.data.reserved));
    }

    // ─── Budget Transactions ─────────────────────────────────────
    match /budgetTransactions/{doc} {
      allow read: if isOfficer();
      allow create: if isStaff();
      allow update, delete: if isCaptain();
    }

    // Immutable reversals created atomically when a released case is deleted.
    match /budgetReversals/{caseId} {
      allow read: if isOfficer();
      allow create: if request.auth != null
                    && request.resource.data.type
                        in ['deduction_reversal', 'reservation_release']
                    && request.resource.data.caseId == caseId
                    && request.resource.data.actorId == request.auth.uid
                    && request.resource.data.amount >= 0
                    && existsAfter(
                         /databases/$(database)/documents/auditEvents/$(caseId)
                       )
                    && getAfter(
                         /databases/$(database)/documents/auditEvents/$(caseId)
                       ).data.budgetReversalId == caseId
                    && getAfter(
                         /databases/$(database)/documents/auditEvents/$(caseId)
                       ).data.budgetProgramId
                        == request.resource.data.programId;
      allow update, delete: if false;
    }

    // ─── Distributions ───────────────────────────────────────────
    match /distributions/{doc} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // ─── Reports ─────────────────────────────────────────────────
    match /reports/{doc} {
      allow read: if isCaptain();
      allow write: if isCaptain();
    }

    // ─── Compliance Snapshots ────────────────────────────────────
    // Written only by cron scripts (Firebase Admin SDK bypasses rules)
    match /complianceSnapshots/{doc} {
      allow read: if isOfficer();
      allow write: if false;
    }
  }
}
