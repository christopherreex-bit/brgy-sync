rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ────────────────────────────────────────
    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isResident() { return getRole() == 'resident'; }
    function isStaff()   { return getRole() in ['staff', 'officer', 'captain']; }
    function isOfficer() { return getRole() in ['officer', 'captain']; }
    function isTreasurer() { return getRole() == 'treasurer'; }
    function hasActiveCaptainDelegation() {
      return request.auth != null
             && exists(/databases/$(database)/documents/captainDelegations/current)
             && get(/databases/$(database)/documents/captainDelegations/current).data.active == true
             && get(/databases/$(database)/documents/captainDelegations/current).data.delegateUid == request.auth.uid
             && get(/databases/$(database)/documents/captainDelegations/current).data.expiresAt > request.time
             && getRole() in ['staff', 'officer'];
    }
    function isCaptain() {
      return getRole() == 'captain' || hasActiveCaptainDelegation();
    }
    function isFinanceReader() {
      return isCaptain() || isOfficer() || isTreasurer();
    }
    function isFinanceManager() {
      return isCaptain() || isTreasurer();
    }
    function currentUserMobile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.mobile;
    }
    function cashMovementAfter(movementId) {
      return getAfter(
        /databases/$(database)/documents/cashMovements/$(movementId)
      ).data;
    }
    function cashMovementBefore(movementId) {
      return get(
        /databases/$(database)/documents/cashMovements/$(movementId)
      ).data;
    }
    function canCreateCaseForResident(caseData) {
      return caseData.residentId == request.auth.uid
             || (isStaff()
                 && caseData.submissionChannel == 'walk_in'
                 && caseData.encodedById == request.auth.uid
                 && exists(/databases/$(database)/documents/users/$(caseData.residentId))
                 && get(/databases/$(database)/documents/users/$(caseData.residentId)).data.role == 'resident');
    }

    // ─── Users ───────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth.uid == userId || isStaff();
      allow create: if getRole() == 'captain'
                    || (request.auth.uid == userId
                        && request.resource.data.role == 'resident');
      allow update: if getRole() == 'captain'
                    || (request.auth.uid == userId
                        && request.resource.data.role == resource.data.role);
      allow delete: if request.auth.uid == userId || getRole() == 'captain';
    }

    // One active, expiring delegation at a time. Only the permanent captain
    // may grant or revoke it; an acting captain cannot delegate onward.
    match /captainDelegations/{delegationId} {
      allow read: if request.auth != null;
      allow create, update: if getRole() == 'captain'
                            && delegationId == 'current'
                            && request.resource.data.delegateUid is string
                            && request.resource.data.delegateRole in ['staff', 'officer']
                            && request.resource.data.expiresAt is timestamp
                            && (request.resource.data.active == false
                                || request.resource.data.expiresAt > request.time)
                            && exists(/databases/$(database)/documents/users/$(request.resource.data.delegateUid))
                            && get(/databases/$(database)/documents/users/$(request.resource.data.delegateUid)).data.role
                                in ['staff', 'officer']
                            && get(/databases/$(database)/documents/users/$(request.resource.data.delegateUid)).data.isActive != false;
      allow delete: if false;
    }

    match /captainDelegationEvents/{eventId} {
      allow read: if getRole() == 'captain';
      allow create: if getRole() == 'captain'
                    && request.resource.data.eventId == eventId
                    && request.resource.data.eventType
                        in ['granted', 'revoked', 'duration_changed'];
      allow update, delete: if false;
    }

    // Mobile numbers claimed by newly created accounts. Document IDs are the
    // normalized 09XXXXXXXXX number, making concurrent duplicate claims fail.
    match /mobileIdentifiers/{mobile} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
                    && mobile.matches('^09[0-9]{9}$')
                    && request.resource.data.uid is string
                    && (request.resource.data.uid == request.auth.uid
                        || getRole() == 'captain');
      allow update: if false;
      allow delete: if request.auth != null
                    && (resource.data.uid == request.auth.uid
                        || getRole() == 'captain');
    }

    // ─── Citizen Registry ────────────────────────────────────────
    // The registry is authoritative and independent of login accounts.
    // Residents can only read a record whose unique mobile matches their
    // account; registry creation and edits remain barangay-controlled.
    match /citizenRegistry/{registryId} {
      allow read: if isStaff()
                  || (request.auth != null
                      && resource.data.mobile == currentUserMobile());
      allow create: if isStaff()
                    || (request.auth != null
                        && registryId == request.resource.data.mobile
                        && request.resource.data.createdByAccountId == request.auth.uid
                        && request.resource.data.source == 'account_registration'
                        && request.resource.data.verificationStatus == 'pending_verification'
                        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
                        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'resident'
                        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.mobile
                            == request.resource.data.mobile);
      allow update: if isStaff();
      allow delete: if isCaptain();

      match /verifiedDocuments/{documentId} {
        allow read: if isStaff()
                    || (request.auth != null
                        && get(/databases/$(database)/documents/citizenRegistry/$(registryId)).data.mobile
                            == currentUserMobile());
        allow create, update: if isStaff();
        allow delete: if isCaptain();
      }

    }

    match /registryCorrections/{correctionId} {
      allow read: if isStaff()
                  || (request.auth != null
                      && resource.data.residentId == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.residentId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.requestedChanges is map
                    && exists(/databases/$(database)/documents/citizenRegistry/$(request.resource.data.registryId))
                    && get(/databases/$(database)/documents/citizenRegistry/$(request.resource.data.registryId)).data.mobile
                        == currentUserMobile();
      allow update: if isOfficer();
      allow delete: if false;
    }

    // A case creates one immutable observation that staff can compare with the
    // verified registry without silently replacing authoritative information.
    match /registryObservations/{caseId} {
      allow read: if isStaff()
                  || (request.auth != null
                      && resource.data.residentId == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.caseId == caseId
                    && existsAfter(/databases/$(database)/documents/cases/$(caseId))
                    && canCreateCaseForResident(
                         getAfter(/databases/$(database)/documents/cases/$(caseId)).data
                       );
      allow update: if isStaff();
      allow delete: if isCaptain();
    }

    // ─── Cases ───────────────────────────────────────────────────
    match /cases/{caseId} {
      allow read: if request.auth.uid == resource.data.residentId || isStaff();
      // Residents reserve the globally next sequence number and create their
      // case together in one atomic transaction.
      allow create: if request.auth != null
                    && canCreateCaseForResident(request.resource.data)
                    && request.resource.data.sequenceYear is int
                    && request.resource.data.sequenceNumber is int
                    && getAfter(/databases/$(database)/documents/caseCounters/$(request.resource.data.sequenceYear)).data.lastCaseId == caseId
                    && getAfter(/databases/$(database)/documents/caseCounters/$(request.resource.data.sequenceYear)).data.lastNumber == request.resource.data.sequenceNumber;
      // Staff and officers may update cases, but only the captain may perform
      // the final transition into For Claiming.
      allow update: if isStaff()
                    && (request.resource.data.status != 'for_claiming'
                        || isCaptain())
                    || (request.auth != null
                        && resource.data.residentId == request.auth.uid
                        && resource.data.status == 'needs_correction'
                        && request.resource.data.status
                            == resource.data.correctionRequest.returnStatus
                        && request.resource.data.status
                            in ['pending_review', 'processing']
                        && request.resource.data.correctionRequest.status == 'submitted'
                        && request.resource.data.correctionRequest.submittedBy == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly([
                              'requestDetails',
                              'documents',
                              'status',
                              'lastUpdated',
                              'statusUpdatedAt',
                              'correctionRequest'
                            ]));
      allow delete: if request.auth != null
                    && (resource.data.residentId == request.auth.uid || isCaptain())
                    && existsAfter(/databases/$(database)/documents/auditEvents/$(caseId))
                    && getAfter(/databases/$(database)/documents/auditEvents/$(caseId)).data.eventType == 'case_deleted'
                    && getAfter(/databases/$(database)/documents/auditEvents/$(caseId)).data.actorId == request.auth.uid;

    }

    // ─── Global Case Number Counters ─────────────────────────────
    // One counter per calendar year, shared by every resident.
    match /caseCounters/{year} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.lastNumber == 1
                    && request.resource.data.lastCaseId is string
                    && existsAfter(/databases/$(database)/documents/cases/$(request.resource.data.lastCaseId))
                    && canCreateCaseForResident(getAfter(/databases/$(database)/documents/cases/$(request.resource.data.lastCaseId)).data)
                    && getAfter(/databases/$(database)/documents/cases/$(request.resource.data.lastCaseId)).data.sequenceNumber == 1;
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['lastNumber', 'lastCaseId', 'lastUpdated'])
                    && request.resource.data.lastNumber == resource.data.lastNumber + 1
                    && request.resource.data.lastCaseId is string
                    && existsAfter(/databases/$(database)/documents/cases/$(request.resource.data.lastCaseId))
                    && canCreateCaseForResident(getAfter(/databases/$(database)/documents/cases/$(request.resource.data.lastCaseId)).data)
                    && getAfter(/databases/$(database)/documents/cases/$(request.resource.data.lastCaseId)).data.sequenceNumber == request.resource.data.lastNumber;
      allow delete: if false;
    }

    match /certificateCounters/{year} {
      allow read, create, update: if isStaff();
      allow delete: if isCaptain();
    }

    // ─── Action Log — collection group access ───────────────────
    // Top-level match required for collectionGroup('actionLog') queries
    match /{path=**}/actionLog/{logId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /cases/{caseId}/actionLog/{logId} {
      allow read, delete: if request.auth != null
                          && (get(/databases/$(database)/documents/cases/$(caseId)).data.residentId == request.auth.uid
                              || isCaptain());
      allow create: if request.auth != null
                    && request.resource.data.residentCorrection == true
                    && request.resource.data.staffId == request.auth.uid
                    && request.resource.data.previousStatus == 'needs_correction'
                    && request.resource.data.newStatus
                        == getAfter(/databases/$(database)/documents/cases/$(caseId)).data.status
                    && getAfter(/databases/$(database)/documents/cases/$(caseId)).data.residentId == request.auth.uid
                    && getAfter(/databases/$(database)/documents/cases/$(caseId)).data.status
                        in ['pending_review', 'processing'];
    }

    // Immutable record required whenever a case is permanently deleted.
    match /auditEvents/{caseId} {
      allow read: if isStaff();
      allow create: if request.auth != null
                    && request.resource.data.eventType == 'case_deleted'
                    && request.resource.data.caseId == caseId
                    && request.resource.data.actorId == request.auth.uid
                    && request.resource.data.deletionReason is string
                    && request.resource.data.deletionReason.size() > 0
                    && request.resource.data.referenceNumber
                        == get(/databases/$(database)/documents/cases/$(caseId)).data.referenceNumber
                    && (get(/databases/$(database)/documents/cases/$(caseId)).data.residentId == request.auth.uid
                        || isCaptain())
                    && !existsAfter(/databases/$(database)/documents/cases/$(caseId));
      allow update, delete: if false;
    }

    // ─── SLA Config ──────────────────────────────────────────────
    match /slaConfig/{doc} {
      // Residents also need these values to calculate the deadline attached
      // to a newly submitted case.
      allow read: if request.auth != null;
      allow write: if isCaptain();
    }

    // ─── Budget Programs ─────────────────────────────────────────
    match /budgetPrograms/{doc} {
      allow read: if request.auth != null;
      allow create, delete: if isFinanceManager();
      allow update: if isFinanceManager()
                    || (isStaff()
                        && request.resource.data.diff(resource.data)
                            .affectedKeys()
                            .hasOnly(['utilized', 'reserved', 'remaining', 'status', 'lastUpdated'])
                        && request.resource.data.utilized >= resource.data.utilized
                        && request.resource.data.remaining
                            == request.resource.data.allocated
                               - request.resource.data.utilized
                               - request.resource.data.reserved)
                    || (request.auth != null
                        && request.resource.data.diff(resource.data)
                            .affectedKeys()
                            .hasOnly([
                              'utilized',
                              'reserved',
                              'remaining',
                              'status',
                              'lastReversalCaseId',
                              'lastUpdated'
                            ])
                        && request.resource.data.lastReversalCaseId is string
                        && request.resource.data.utilized <= resource.data.utilized
                        && request.resource.data.remaining
                            == request.resource.data.allocated
                               - request.resource.data.utilized
                               - request.resource.data.reserved
                        && existsAfter(
                             /databases/$(database)/documents/auditEvents/$(request.resource.data.lastReversalCaseId)
                           )
                        && getAfter(
                             /databases/$(database)/documents/auditEvents/$(request.resource.data.lastReversalCaseId)
                           ).data.actorId == request.auth.uid
                        && getAfter(
                             /databases/$(database)/documents/auditEvents/$(request.resource.data.lastReversalCaseId)
                           ).data.budgetProgramId == doc
                        && existsAfter(
                             /databases/$(database)/documents/budgetReversals/$(request.resource.data.lastReversalCaseId)
                           )
                        && getAfter(
                             /databases/$(database)/documents/budgetReversals/$(request.resource.data.lastReversalCaseId)
                           ).data.programId == doc
                        && (getAfter(
                              /databases/$(database)/documents/budgetReversals/$(request.resource.data.lastReversalCaseId)
                            ).data.amount
                             == resource.data.utilized
                                - request.resource.data.utilized
                            || getAfter(
                                 /databases/$(database)/documents/budgetReversals/$(request.resource.data.lastReversalCaseId)
                               ).data.amount
                                == resource.data.reserved
                                   - request.resource.data.reserved));
    }

    // ─── Budget Transactions ─────────────────────────────────────
    match /budgetTransactions/{doc} {
      allow read: if isFinanceReader();
      allow create: if isStaff() || isTreasurer();
      allow update, delete: if isFinanceManager();
    }

    // Cash liquidity is separate from appropriations. The current position is
    // updated atomically with an immutable movement record by application
    // workflows. Only the captain may establish the opening position or
    // request a bank withdrawal.
    match /cashPositions/{doc} {
      allow read: if isFinanceReader();
      allow create: if isFinanceManager()
                    && doc == 'current'
                    && request.resource.data.initialized == true
                    && request.resource.data.cashInBank >= 0
                    && request.resource.data.cashOnHand >= 0
                    && request.resource.data.cashInTransit == 0
                    && request.resource.data.lastMovementId is string
                    && existsAfter(
                         /databases/$(database)/documents/cashMovements/$(request.resource.data.lastMovementId)
                       )
                    && cashMovementAfter(request.resource.data.lastMovementId).type
                        == 'opening_balance'
                    && cashMovementAfter(request.resource.data.lastMovementId).bankAmount
                        == request.resource.data.cashInBank
                    && cashMovementAfter(request.resource.data.lastMovementId).onHandAmount
                        == request.resource.data.cashOnHand;
      allow update: if (isStaff() || isTreasurer())
                    && doc == 'current'
                    && request.resource.data.cashInBank >= 0
                    && request.resource.data.cashOnHand >= 0
                    && request.resource.data.cashInTransit >= 0
                    && request.resource.data.lastMovementId is string
                    && request.resource.data.diff(resource.data)
                        .affectedKeys()
                        .hasOnly([
                          'cashInBank',
                          'cashOnHand',
                          'cashInTransit',
                          'lastMovementId',
                          'lastUpdated'
                        ])
                    && existsAfter(
                         /databases/$(database)/documents/cashMovements/$(request.resource.data.lastMovementId)
                       )
                    && (
                      // New funding enters through the bank and must have a
                      // matching captain-recorded receipt.
                      (!exists(
                         /databases/$(database)/documents/cashMovements/$(request.resource.data.lastMovementId)
                       )
                       && isFinanceManager()
                       && cashMovementAfter(request.resource.data.lastMovementId).type
                           == 'bank_receipt'
                       && cashMovementAfter(request.resource.data.lastMovementId).status
                           == 'completed'
                       && cashMovementAfter(request.resource.data.lastMovementId).requestedBy
                           == request.auth.uid
                       && request.resource.data.cashInBank
                              - resource.data.cashInBank
                           == cashMovementAfter(request.resource.data.lastMovementId).amount
                       && request.resource.data.cashInTransit
                           == resource.data.cashInTransit
                       && request.resource.data.cashOnHand
                           == resource.data.cashOnHand)
                      ||
                      // Captain requests a new withdrawal: bank decreases
                      // while the exact amount enters transit.
                      (!exists(
                         /databases/$(database)/documents/cashMovements/$(request.resource.data.lastMovementId)
                       )
                       && isFinanceManager()
                       && cashMovementAfter(request.resource.data.lastMovementId).type
                           == 'bank_to_hand'
                       && cashMovementAfter(request.resource.data.lastMovementId).status
                           == 'pending'
                       && cashMovementAfter(request.resource.data.lastMovementId).requestedBy
                           == request.auth.uid
                       && resource.data.cashInBank
                              - request.resource.data.cashInBank
                           == cashMovementAfter(request.resource.data.lastMovementId).amount
                       && request.resource.data.cashInTransit
                              - resource.data.cashInTransit
                           == cashMovementAfter(request.resource.data.lastMovementId).amount
                       && request.resource.data.cashOnHand
                           == resource.data.cashOnHand)
                      ||
                      // A matured withdrawal moves the exact amount from
                      // transit into cash on hand.
                      (exists(
                         /databases/$(database)/documents/cashMovements/$(request.resource.data.lastMovementId)
                       )
                       && cashMovementBefore(request.resource.data.lastMovementId).type
                           == 'bank_to_hand'
                       && cashMovementBefore(request.resource.data.lastMovementId).status
                           == 'pending'
                       && cashMovementAfter(request.resource.data.lastMovementId).status
                           == 'completed'
                       && request.resource.data.cashInBank
                           == resource.data.cashInBank
                       && resource.data.cashInTransit
                              - request.resource.data.cashInTransit
                           == cashMovementBefore(request.resource.data.lastMovementId).amount
                       && request.resource.data.cashOnHand
                              - resource.data.cashOnHand
                           == cashMovementBefore(request.resource.data.lastMovementId).amount)
                      ||
                      // Releasing a case reduces only cash on hand and must
                      // create the matching immutable case movement.
                      (!exists(
                         /databases/$(database)/documents/cashMovements/$(request.resource.data.lastMovementId)
                       )
                       && cashMovementAfter(request.resource.data.lastMovementId).type
                           == 'case_disbursement'
                       && cashMovementAfter(request.resource.data.lastMovementId).status
                           == 'completed'
                       && cashMovementAfter(request.resource.data.lastMovementId).requestedBy
                           == request.auth.uid
                       && request.resource.data.cashInBank
                           == resource.data.cashInBank
                       && request.resource.data.cashInTransit
                           == resource.data.cashInTransit
                       && resource.data.cashOnHand
                              - request.resource.data.cashOnHand
                           == cashMovementAfter(request.resource.data.lastMovementId).amount)
                    );
      allow delete: if false;
    }

    match /cashMovements/{movementId} {
      allow read: if isFinanceReader();
      allow create: if (isStaff() || isTreasurer())
                    && request.resource.data.requestedBy == request.auth.uid
                    && request.resource.data.type
                        in ['opening_balance', 'bank_receipt', 'bank_to_hand', 'case_disbursement']
                    && (request.resource.data.type != 'bank_to_hand'
                        || isFinanceManager())
                    && (request.resource.data.type != 'bank_receipt'
                        || (isFinanceManager()
                            && request.resource.data.status == 'completed'
                            && request.resource.data.amount > 0
                            && request.resource.data.source is string
                            && request.resource.data.source.size() > 0
                            && request.resource.data.referenceNumber is string
                            && request.resource.data.referenceNumber.size() > 0))
                    && (request.resource.data.type != 'opening_balance'
                        || (isFinanceManager()
                            && request.resource.data.status == 'completed'
                            && request.resource.data.bankAmount >= 0
                            && request.resource.data.onHandAmount >= 0))
                    && (request.resource.data.type != 'bank_to_hand'
                        || (request.resource.data.status == 'pending'
                            && request.resource.data.amount > 0))
                    && (request.resource.data.type != 'case_disbursement'
                        || (request.resource.data.status == 'completed'
                            && request.resource.data.amount > 0
                            && request.resource.data.caseId is string));
      allow update: if (isStaff() || isTreasurer())
                    && resource.data.type == 'bank_to_hand'
                    && resource.data.status == 'pending'
                    && request.resource.data.status == 'completed'
                    && request.resource.data.diff(resource.data)
                        .affectedKeys()
                        .hasOnly(['status', 'completedAt']);
      allow delete: if false;
    }

    // Immutable reversals created atomically when a released case is deleted.
    match /budgetReversals/{caseId} {
      allow read: if isOfficer();
      allow create: if request.auth != null
                    && request.resource.data.type
                        in ['deduction_reversal', 'reservation_release']
                    && request.resource.data.caseId == caseId
                    && request.resource.data.actorId == request.auth.uid
                    && request.resource.data.amount >= 0
                    && existsAfter(
                         /databases/$(database)/documents/auditEvents/$(caseId)
                       )
                    && getAfter(
                         /databases/$(database)/documents/auditEvents/$(caseId)
                       ).data.budgetReversalId == caseId
                    && getAfter(
                         /databases/$(database)/documents/auditEvents/$(caseId)
                       ).data.budgetProgramId
                        == request.resource.data.programId;
      allow update, delete: if false;
    }

    // ─── Distributions ───────────────────────────────────────────
    match /distributions/{doc} {
      allow read: if isStaff();
      allow create: if isCaptain()
                    && request.resource.data.status == 'released'
                    && request.resource.data.amount == 1000
                    && request.resource.data.programType
                        in ['senior_birthday', 'pwd_birthday']
                    && request.resource.data.releasedBy == request.auth.uid;
      allow update, delete: if false;
    }

    // ─── Reports ─────────────────────────────────────────────────
    match /reports/{doc} {
      allow read: if isCaptain();
      allow write: if isCaptain();
    }

    // ─── Compliance Snapshots ────────────────────────────────────
    // Written only by cron scripts (Firebase Admin SDK bypasses rules)
    match /complianceSnapshots/{doc} {
      allow read: if isOfficer();
      allow write: if false;
    }
  }
}
